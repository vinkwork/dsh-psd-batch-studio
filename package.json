{
  "name": "dsh-psd-batch-studio",
  "version": "0.3.0",
  "description": "PSD/PSB parse-and-control engine for agents: inspect templates, render job specs (text runs, visibility, images, product slots), view details, check text drift. Ships as a DeepSeek Harness plugin and a CLI.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinkwork/dsh-psd-batch-studio.git"
  },
  "homepage": "https://github.com/vinkwork/dsh-psd-batch-studio",
  "bugs": {
    "url": "https://github.com/vinkwork/dsh-psd-batch-studio/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "psd",
    "psd-template",
    "batch-image",
    "ecommerce",
    "canvas"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./engine": "./src/engine.js"
  },
  "files": [
    "index.js",
    "server.js",
    "client.js",
    "src/core/*.js",
    "src/engine.js",
    "bin/psd-engine.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "README.md",
    "LICENSING.md",
    "LICENSE-APACHE",
    "README.en.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node test/smoke.mjs && node test/dsh-host.mjs && node test/cli.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "ag-psd": "^25.0.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "esbuild": "^0.25.0"
  },
  "author": "VinkWork team at Genca (上海缙嘉科技有限公司) <https://vinkclaw.com>",
  "bin": {
    "psd-engine": "./bin/psd-engine.mjs"
  }
}
